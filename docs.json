{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GreenTick",
  "colors": {
    "primary": "#128C7E",
    "light": "#25D366",
    "dark": "#075E54"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@greentick.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.greentick.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/showcase/greentick-simplest-whatsapp-marketing-platform-for-business/home",
      "instagram": "https://instagram.com/greentick_ai",
      "youtube": "https://youtube.com/@WAGrowthLab"
    }
  },
  "search": {
    "prompt": "Search GreenTick docs"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.greentick.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "connect-whatsapp"
            ]
          },
          {
            "group": "Contacts",
            "icon": "address-book",
            "pages": [
              "contacts/overview",
              "contacts/labels-and-attributes"
            ]
          },
          {
            "group": "Messaging",
            "icon": "comments",
            "pages": [
              "messaging/templates",
              "messaging/broadcasts",
              "messaging/live-chat"
            ]
          },
          {
            "group": "Automation",
            "icon": "diagram-project",
            "pages": [
              "automation/automations",
              "automation/flows",
              "automation/ai-bot",
              "automation/catalogs",
              "automation/whatsapp-ads"
            ]
          },
          {
            "group": "Account",
            "icon": "users",
            "pages": [
              "account/plans",
              "account/team"
            ]
          },
          {
            "group": "Developers",
            "icon": "code",
            "pages": [
              "developers/overview",
              "developers/authentication",
              "developers/send-messages",
              "developers/webhooks",
              "developers/integrations"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "robot",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "mcp/index",
              "mcp/rules"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "mcp/messages",
              "mcp/templates",
              "mcp/media",
              "mcp/automations",
              "mcp/flows",
              "mcp/ai-bots",
              "mcp/broadcasts",
              "mcp/inbox",
              "mcp/contacts",
              "mcp/catalogs"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "openapi": "openapi.json"
      }
    ]
  }
}
