{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GreenTick",
  "colors": {
    "primary": "#128C7E",
    "light": "#25D366",
    "dark": "#075E54"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@greentick.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.greentick.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/showcase/greentick-simplest-whatsapp-marketing-platform-for-business/home",
      "instagram": "https://instagram.com/greentick_ai",
      "youtube": "https://youtube.com/@WAGrowthLab"
    }
  },
  "search": {
    "prompt": "Search GreenTick docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.greentick.ai"
    }
  },
  "redirects": [
    {
      "source": "/mcp/overview",
      "destination": "/mcp/introduction",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Help Center",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
